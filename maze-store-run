#!/usr/bin/env bash
# =============================================================================
#  maze-store-run — the only part of Maze Store that changes the system.
#
#  Runs inside a terminal window opened by the store:
#      maze-store-run install <pkg>...
#      maze-store-run remove  <pkg>...
#      maze-store-run upgrade
#
#  It prints the exact command, then runs it with `sudo -k`, so the password is
#  asked for every single time (a cached sudo timestamp is ignored) and is typed
#  into sudo — never into the store. pacman shows its own transaction summary
#  and asks for confirmation; nothing here passes --noconfirm.
# =============================================================================
set -u

if [[ -t 1 ]]; then
  B='\033[1m'; D='\033[2m'; G='\033[1;97m'; R='\033[0;31m'; N='\033[0m'
else
  B=''; D=''; G=''; R=''; N=''
fi

finish() {
  echo
  read -rsn1 -p "$(printf "${D}  Pencereyi kapatmak için bir tuşa basın · Press any key to close${N}")" || true
  echo
  exit "${1:-0}"
}

action="${1:-}"; shift || true

for p in "$@"; do
  if [[ ! "$p" =~ ^[a-z0-9@_+][a-z0-9@._+-]{0,127}$ ]]; then
    printf "${R}  Geçersiz paket adı / invalid package name: %q${N}\n" "$p"
    finish 2
  fi
done

case "$action" in
  install) [[ $# -gt 0 ]] || finish 2; cmd=(sudo -k pacman -Syu --needed -- "$@"); verb="Kuruluyor · Installing" ;;
  remove)  [[ $# -gt 0 ]] || finish 2; cmd=(sudo -k pacman -Rns -- "$@");          verb="Kaldırılıyor · Removing" ;;
  upgrade) cmd=(sudo -k pacman -Syu);                                                verb="Sistem güncelleniyor · Upgrading" ;;
  *) printf "${R}  Bilinmeyen işlem / unknown action: %q${N}\n" "$action"; finish 2 ;;
esac

clear 2>/dev/null || true
printf "\n  ${B}M A Z E   S T O R E${N}\n\n"
printf "  ${verb}${*:+: ${B}$*${N}}\n\n"
printf "  ${D}Çalıştırılacak komut · Command:${N}\n"
printf "  ${G}\$ sudo pacman"
for a in "${cmd[@]:3}"; do [[ "$a" == "--" ]] || printf " %s" "$a"; done
printf "${N}\n\n"
printf "  ${D}Şifren sudo tarafından sorulur; Maze Store şifreni görmez.${N}\n"
printf "  ${D}Your password is asked by sudo; Maze Store never sees it.${N}\n\n"

"${cmd[@]}"
rc=$?

echo
if [[ $rc -eq 0 ]]; then
  printf "  ${G}${B}✓ Tamamlandı · Done${N}\n"
else
  printf "  ${R}${B}✗ İşlem tamamlanmadı (çıkış kodu %d) · Did not complete (exit %d)${N}\n" "$rc" "$rc"
fi
finish "$rc"
